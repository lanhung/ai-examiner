{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(ai_examiner_http_server_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(ai_examiner_http_server_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(ai_examiner_http_server_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "title": "Server error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_examiner_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "sum by (celery_state) (rate(ai_examiner_jobs_deliveries_total[10m]))",
          "legendFormat": "{{celery_state}}"
        }
      ],
      "title": "Background job deliveries",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[5m]))",
          "legendFormat": "failed spans"
        }
      ],
      "title": "Telemetry export failures",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["ai-examiner", "operations"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "AI Examiner Operations",
  "uid": "ai-examiner-operations",
  "version": 1
