# AI Examiner classroom pilot — copy to .env and fill in every value marked REQUIRED.
# Used with: docker-compose.yml + docker-compose.prod.yml + docker-compose.pilot.yml
# Full guide: docs/deployment/V0_10_PILOT_LAUNCH_RUNBOOK.md

APP_NAME=AI Examiner
APP_PORT=8000
# REQUIRED: the public domain students will open (DNS A record -> this server).
# Caddy obtains the HTTPS certificate automatically.
SITE_ADDRESS=exam.example.com

# REQUIRED: teacher login for the workbench (/) and every non-student page.
# Create the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains "$" characters.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD_HASH='replace-with-bcrypt-hash'

# Authentication is handled by the teacher password at the proxy; students are
# anonymous and hold only the join code and their attempt token.
APP_ENV=production
AUTH_MODE=disabled
ALLOW_UNSAFE_AUTH_DISABLED_IN_PRODUCTION=true
TRUST_PROXY_FORWARDED_FOR=true

# REQUIRED: model provider. Qwen (Alibaba Cloud Model Studio / DashScope) is the
# tested default for Chinese material.
MODEL_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_REQUEST_TIMEOUT_SECONDS=240
QWEN_ENABLE_THINKING=false

# REQUIRED: random secrets, e.g. `openssl rand -hex 32`.
AUDIT_IP_HASH_KEY=
MEMORY_IDENTITY_SECRET=

# Storage (single server)
DATABASE_URL=sqlite:///./data/ai_examiner.db
DATABASE_SCHEMA_MANAGEMENT=startup
STORAGE_BACKEND=local
MODEL_RATE_LIMIT_BACKEND=redis
MODEL_RATE_LIMIT_REQUIRED=true

# Classroom capacity. Allowed concurrent model calls ≈ class size ÷ 2.5 keeps
# answers under ~15 s. Also run, once after the first start:
#   docker compose ... run --rm ai-examiner ai-examiner-set-model-limits \
#     --max-concurrent-calls 16 --organization-requests-per-minute 1200 \
#     --principal-requests-per-minute 1200 --monthly-budget-usd 100
LEARNER_MODEL_CONCURRENCY=16
LEARNER_MODEL_QUEUE_TIMEOUT_SECONDS=90
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=30
HTTP_WORKER_THREADS=150

# Abuse protection for the anonymous student pages (per client IP / attempt).
LEARNER_RATE_LIMIT_ENABLED=true
LEARNER_JOIN_LOOKUPS_PER_IP_PER_MINUTE=300
LEARNER_ATTEMPTS_PER_IP_PER_10_MINUTES=300
LEARNER_ANSWERS_PER_ATTEMPT_PER_MINUTE=10
LEARNER_ANSWER_MAX_CHARS=4000

# Daily spend guard for all model calls (USD).
DAILY_MODEL_BUDGET_USD=20
PROJECT_MODEL_BUDGET_USD=10
