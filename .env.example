APP_NAME=AI Examiner
APP_ENV=development
APP_PORT=8000
MODEL_PROVIDER=mock

# Enterprise authentication. Keep disabled for local evaluation only.
AUTH_MODE=disabled
ALLOW_UNSAFE_AUTH_DISABLED_IN_PRODUCTION=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGIN_REDIRECT=/
OIDC_SCOPES=openid profile email
OIDC_REQUIRED_SCOPES=
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_ACCESS_TOKEN_TYPES=at+jwt
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_DISCOVERY_TTL_SECONDS=300
OIDC_JWKS_TTL_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_LOGIN_TTL_MINUTES=10
OIDC_SESSION_MAX_MINUTES=480
OIDC_SESSION_COOKIE_NAME=axe_session
OIDC_PRINCIPAL_PROVISIONING=existing_only
AUTH_SESSION_SECRET=
OIDC_ALLOW_INSECURE_HTTP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_DOCUMENT_CHARS=12000
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2500

# OpenAI Realtime speech-to-speech
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_VAD_EAGERNESS=medium
REALTIME_SESSION_MAX_MINUTES=55

# Qwen3 Omni Realtime speech-to-speech (Alibaba Cloud Model Studio)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISUAL_MODEL=qwen3-vl-plus
# Full Planner output can exceed two minutes on qwen-plus. The browser uses a
# persisted background job, so this provider deadline does not block the UI.
QWEN_REQUEST_TIMEOUT_SECONDS=240
# Interactive calls default to non-thinking mode for lower latency. Enable only
# when benchmark results justify the extra response time and token cost.
QWEN_ENABLE_THINKING=false
QWEN_REALTIME_MODEL=qwen3-omni-flash-realtime
QWEN_REALTIME_VOICE=Cherry
QWEN_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

GOLDEN_DEFAULT_PROFILES=mock:heuristic-v2
BENCHMARK_DEFAULT_PROFILES=mock:heuristic-v2
VISUAL_DEFAULT_PROFILE=mock:heuristic-v2
GOLDEN_QUESTION_COUNT=8
BENCHMARK_CASE_LIMIT=4

DATABASE_URL=sqlite:///./data/ai_examiner.db
# Use external for PostgreSQL RLS deployments. Run Alembic with a migration role
# before starting the API and worker runtime roles.
DATABASE_SCHEMA_MANAGEMENT=startup
# off for SQLite/local evaluation; enforce requires PostgreSQL + OIDC.
POSTGRES_RLS_MODE=off

# Tenant object storage. Local remains the single-node default. For the
# optional MinIO Compose profile, use docker-compose.minio.yml and set the
# MINIO_ROOT_* values below.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/objects
STORAGE_DOWNLOAD_MODE=stream
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUIRE_TLS=true
S3_ALLOW_INSECURE_HTTP=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
S3_PRESIGN_TTL_SECONDS=300
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

UPLOAD_DIR=./data/uploads
EVIDENCE_DIR=./data/evidence
EXPORT_DIR=./data/exports
BACKUP_DIR=./data/backups
PROMPT_DIR=./prompts
MAX_UPLOAD_MB=50
MAX_DOCUMENT_CHARS=180000
RENDER_DPI=144
MAX_VISUAL_PAGES=30

REDIS_URL=redis://redis:6379/0
CELERY_ALWAYS_EAGER=false
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_RECOVERY_BATCH_SIZE=100
JOB_ORPHAN_GRACE_SECONDS=120

# WP-08 append-only audit. Production requires a high-entropy HMAC key.
AUDIT_REQUIRED=true
AUDIT_IP_HASH_KEY=
AUDIT_RETENTION_DAYS=365
AUDIT_EXPORT_MAX_ROWS=10000

# WP-10 organization export safety limits. Export TTL can be further reduced
# by each organization's retention policy.
ORGANIZATION_EXPORT_MAX_BYTES=268435456
ORGANIZATION_EXPORT_DEFAULT_TTL_HOURS=24

DAILY_MODEL_BUDGET_USD=20
PROJECT_MODEL_BUDGET_USD=10
MAX_CONCURRENT_MODEL_CALLS=3
MAX_MODEL_RETRIES=2

# Optional OpenTelemetry export. The observability Compose profile uses an
# internal HTTP endpoint, so explicitly allow that transport when enabled.
TELEMETRY_ENABLED=false
TELEMETRY_REQUIRED=false
TELEMETRY_SERVICE_NAME=ai-examiner
TELEMETRY_SERVICE_NAMESPACE=ai-examiner
TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318
TELEMETRY_OTLP_HEADERS=
TELEMETRY_ALLOW_INSECURE_OTLP=true
TELEMETRY_TRACE_SAMPLE_RATIO=0.1
TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
TELEMETRY_METRIC_INTERVAL_SECONDS=30
TELEMETRY_EXCLUDED_URLS=/health,/ready

# The observability override binds both UIs to localhost by default. Use an
# SSH tunnel or an authenticated reverse proxy instead of exposing them.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# WP-09 organization model policy, quota reservation and Redis rate limiting.
MODEL_GOVERNANCE_ENABLED=true
MODEL_RATE_LIMIT_BACKEND=redis
MODEL_RATE_LIMIT_REQUIRED=true
MODEL_RATE_LIMIT_WINDOW_SECONDS=60
MODEL_CONCURRENCY_LEASE_SECONDS=300
MODEL_RESERVED_OUTPUT_TOKENS=4096

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required only for optional v0.7 cross-project learner memory.
MEMORY_IDENTITY_SECRET=

# Public HTTPS domain for mobile/desktop microphone access, e.g. exam.example.com
SITE_ADDRESS=localhost
