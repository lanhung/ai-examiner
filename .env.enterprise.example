# Copy to a private deployment file, for example .env.enterprise.
# This file contains placeholders only. Use URL-safe random passwords.
APP_ENV=production
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
SITE_ADDRESS=examiner.example.com

POSTGRES_DB=ai_examiner
POSTGRES_MIGRATION_USER=examiner_migration
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_USER=examiner_runtime
POSTGRES_APP_PASSWORD=
ENTERPRISE_MIGRATION_DATABASE_URL=postgresql+psycopg://examiner_migration:URL_ENCODED_PASSWORD@postgres:5432/ai_examiner
ENTERPRISE_DATABASE_URL=postgresql+psycopg://examiner_runtime:URL_ENCODED_PASSWORD@postgres:5432/ai_examiner

AUTH_MODE=oidc
OIDC_ISSUER_URL=https://identity.example.com
OIDC_AUDIENCE=ai-examiner
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://examiner.example.com/api/v1/auth/callback
AUTH_SESSION_SECRET=
AUDIT_IP_HASH_KEY=
MEMORY_IDENTITY_SECRET=

MODEL_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Optional local MinIO profile.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=ai-examiner
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Host-only backup destination. Keep this outside live Docker volumes.
ENTERPRISE_BACKUP_ROOT=./data/enterprise-backups
ENTERPRISE_RPO_HOURS=24
ENTERPRISE_RTO_SECONDS=14400
