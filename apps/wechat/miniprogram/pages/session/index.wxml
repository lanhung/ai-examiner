<view class="page">
  <view class="heading">答辩问答</view><view class="muted">状态：{{status}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{turns}}" wx:key="id" class="item {{item.role === 'user' ? 'answer' : ''}}"><view class="badge">{{item.role === 'user' ? '我的回答' : 'AI 考官'}}</view><view class="body">{{item.content}}</view></view>
  <button wx:if="{{!turns.length}}" class="primary" bindtap="begin" disabled="{{busy || uncertain}}">请考官开始提问</button>
  <block wx:if="{{turns.length && status !== 'completed'}}">
    <voice-answer endpoint="/api/v1/wechat/voice/session/{{id}}" revision="{{turns.length}}" disabled="{{busy || uncertain}}" bind:transcript="voiceText" bind:busy="voiceBusy"/>
    <textarea class="field" value="{{answer}}" bindinput="answer" maxlength="20000" placeholder="输入或确认语音识别后的回答" disabled="{{busy || uncertain || voiceBusy}}"/>
    <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uncertain || voiceBusy || !answer}}">确认并提交回答</button>
  </block>
  <view wx:if="{{uncertain}}" class="muted">{{operationStatus === 'queued' ? '已接收，等待处理' : operationStatus === 'retry_scheduled' ? '模型繁忙，正在排队' : operationStatus === 'running' ? '考官正在分析回答' : '正在确认提交结果'}}。可离开后返回查看结果。</view>
  <button bindtap="refresh" disabled="{{busy}}">刷新会话状态</button>
  <button wx:if="{{status === 'completed'}}" class="primary" bindtap="report">查看答辩报告</button>
</view>
